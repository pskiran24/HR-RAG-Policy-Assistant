# ==============================
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ==============================
# Virtual environments
# ==============================
.venv/
venv/
env/
hrrenv/
hrenv/
genenv/
.venv_eval/

# ==============================
# Logs and temporary files
# ==============================
*.log
*.tmp
*.bak
*.swp

