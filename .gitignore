# IDE and operating system
# ==============================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ==============================
# Local development
# ==============================
.streamlit/config.local.toml
'@ | Set-Content -Path .gitignore -Encoding utf8
!.streamlit/secrets.toml.example
